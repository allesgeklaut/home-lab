# ============================================================================
# LiteLLM Proxy Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Real secrets live in /opt/secrets/litellm.env (not committed).
# ============================================================================

# --------------------------------------------------------------------------
# Host IP / Port
# Bind litellm to this host IP:port. Used for the port mapping and for
# ${LAN_IP} interpolation inside compose.yml (MODEL_CONTAINERS, PORTAINER_URL).
# config.yaml resolves llama.cpp via LLAMA_*_API_BASE in /opt/secrets/litellm.env.
# --------------------------------------------------------------------------
LAN_IP=<your-LAN-IP>
LITELLM_HOST_IP=${LAN_IP}
# LITELLM_PORT=4000  # defined by the compose service port mapping

# --------------------------------------------------------------------------
# Secrets (in /opt/secrets/litellm.env, loaded via compose env_file):
#   LITELLM_MASTER_KEY = sk-... (generate with `openssl rand -hex 32`)
# Portainer creds are in /opt/secrets/portainer.env (shared, already exists)
# --------------------------------------------------------------------------
# LITELLM_MASTER_KEY=sk-CHANGE_ME_generate_with_openssl_rand_hex_32

# --------------------------------------------------------------------------
# LLM idle-manager config (set in compose environment:, not here)
#   MODEL_CONTAINERS      JSON: model_name -> {container, health,
#                         boot_timeout, aliases}. Only one GPU tenant runs at
#                         a time; a request cold-starts its container.
#   EXTRA_GPU_CONTAINERS  comma-separated non-llama tenants (comfyui) that are
#                         stopped before a managed model cold-starts
#   IDLE_TIMEOUT          seconds idle before a llama container is stopped
#   BOOT_TIMEOUT          default cold-start timeout (per-model override:
#                         "boot_timeout" in MODEL_CONTAINERS)
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ComfyUI lifecycle proxy (set in compose environment:, overridable here)
#   COMFYUI_IDLE_TIMEOUT = 900  (seconds idle before comfyui is stopped)
#   COMFYUI_BOOT_TIMEOUT = 90   (seconds to wait for a cold start)
# --------------------------------------------------------------------------
# COMFYUI_IDLE_TIMEOUT=900
# COMFYUI_BOOT_TIMEOUT=90
