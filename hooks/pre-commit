#!/usr/bin/env bash
# Pre-commit hook: run gitleaks on staged changes.
# Exit 1 (blocking the commit) if any secret is detected.

set -euo pipefail

# Non-interactive environments (systemd services, hooks) may not have the
# user's local bin on PATH; add it so user-installed gitleaks is found.
if [ -n "${HOME:-}" ] && [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

if command -v gitleaks >/dev/null 2>&1; then
    exec gitleaks git --pre-commit --staged --redact=100 --no-banner
else
    printf '%s\n' \
        "Commit blocked: gitleaks is not installed." \
        "Install gitleaks (https://github.com/gitleaks/gitleaks#installing)," \
        "then run scripts/install-git-hooks.sh." >&2
    exit 1
fi
