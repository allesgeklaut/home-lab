# ============================================================================
# Engram Cloud environment (documentation copy)
# Real values live in /opt/secrets/engram.env (mode 600, not committed).
# Generate secrets with: openssl rand -hex 32
# ============================================================================

POSTGRES_USER=engram
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=engram_cloud

# Must match POSTGRES_* above; hostname is the compose service name.
ENGRAM_DATABASE_URL=postgres://engram:CHANGE_ME@postgres:5432/engram_cloud?sslmode=disable

# Client bearer token for /sync/* (use a separate value for the dashboard admin).
ENGRAM_CLOUD_TOKEN=CHANGE_ME
# Dashboard admin token.
ENGRAM_CLOUD_ADMIN=CHANGE_ME
# Explicit non-default secret, 32+ bytes, required in authenticated mode.
ENGRAM_JWT_SECRET=CHANGE_ME

# Server-side project allowlist (comma-separated); clients must also enroll.
ENGRAM_CLOUD_ALLOWED_PROJECTS=home-lab,dashboard,my-game,side-project

ENGRAM_CLOUD_HOST=0.0.0.0
ENGRAM_PORT=18080
# Optional, default 8 MiB:
# ENGRAM_CLOUD_MAX_PUSH_BYTES=8388608
