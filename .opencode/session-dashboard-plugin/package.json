{
  "name": "opencode-session-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retro-futuristic session telemetry for OpenCode: subagents, tokens, cost, and configured context budget.",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "tsx --test src/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.gui.json --noEmit && tsc -p tsconfig.tui.json --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "devDependencies": {
    "@opencode/client": "2.3.0",
    "@opencode/theme": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/node": "^22.10.0",
    "effect": "4.1.0",
    "solid-js": "1.9.17",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "6.4.6",
    "vite-plugin-solid": "2.11.10"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "effect": "^4.0.0",
    "solid-js": ">=1.9.0"
  },
  "opencode": {
    "testedWith": ">=2.3.0 <2.4.0"
  }
}
