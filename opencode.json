{
  "$schema": "https://opencode.ai/config.json",
  "model": "mistral/auto",
  "plugins": [
    "@makcimbx/opencode-gpt-imagegen",
    {
      "package": "/opt/stacks/.opencode/session-model-plugin",
      "options": {
        "agents": ["alloy"],
        "models": ["mistral/*"],
        "routing": {
          "selector": "mistral/mistral-large-4#medium",
          "timeoutMs": 45000,
          "candidates": [
            { "model": "mistral/zai-glm-5-3-flash#high", "description": "Fast, low-cost general coding and analysis. High reasoning." },
            { "model": "mistral/zai-glm-5-3-flash#max", "description": "Low-cost general work needing extra reasoning headroom." },
            { "model": "mistral/deepseek-v4-1-flash-1017#high", "description": "Economical coding, debugging and analysis. High reasoning." },
            { "model": "mistral/deepseek-v4-1-flash-1017#max", "description": "Economical coding and analysis with maximum reasoning headroom." },
            { "model": "mistral/mistral-large-4#medium", "description": "Balanced general-purpose model for everyday implementation and analysis." },
            { "model": "mistral/mistral-large-4#high", "description": "General-purpose model with extra reasoning for multi-step work and verification." },
            { "model": "mistral/zai-glm-5-3#high", "description": "Stronger reasoning for elevated uncertainty, complex changes or high-consequence errors." },
            { "model": "mistral/zai-glm-5-3#max", "description": "Strongest reasoning option; reserve for difficult, high-stakes or hard-to-verify tasks." },
            { "model": "mistral/zai-glm-5-3-longctx#max", "description": "Strong reasoning with an extended context budget, only when the task explicitly needs very large context." }
          ]
        }
      }
    }
  ],
  "websearch": {
    "provider": "exa"
  },
  "small_model": "opencode/big-pickle",
  "providers": {
    "opencode-go": {
      "models": {
        "claude-haiku-5-5": {
          "limit": { "input": 106496 }
        },
        "gpt-5.6-luna": {
          "limit": { "input": 255616 }
        },
        "gpt-6-luna": {
          "limit": { "input": 255616 }
        },
        "deepseek-v4.1-flash": {
          "limit": { "input": 262144 }
        },
        "glm-5.3-flash": {
          "limit": { "input": 262144 }
        },
        "qwen3.8-flash": {
          "limit": { "input": 262144 }
        }
      }
    },
    "llama-cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "settings": {
        "baseURL": "http://192.168.0.46:4000/v1",
        "apiKey": "{file:/opt/secrets/litellm.key}"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": { "context": 105472, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "qwen3.8-27b-abliterated": {
          "name": "qwen3.8-27b-abliterated",
          "limit": { "context": 105472, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "nemotron-bolt": {
          "name": "nemotron-bolt",
          "limit": { "context": 262144, "output": 16384 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        }
      }
    },
    "mistral": {
      "models": {
        "mistral-medium-latest": { "disabled": true },
        "mistral-medium-2604": { "disabled": true },
        "ministral-14b-2512": { "disabled": true },
        "ministral-3b-2512": { "disabled": true },
        "ministral-8b-2512": { "disabled": true },
        "ministral-3b-latest": { "disabled": true },
        "ministral-8b-latest": { "disabled": true },
        "codestral-2508": { "disabled": true },
        "codestral-latest": { "disabled": true },
        "voxtral-small-2507": { "disabled": true },
        "voxtral-small-latest": { "disabled": true },
        "mistral-large-2512": { "disabled": true },
        "mistral-large-latest": { "disabled": true },
        "auto": {
          "modelID": "zai-glm-5-3-flash",
          "name": "Auto (routed)",
          "limit": { "input": 307200 }
        },
        "deepseek-v4-1-flash-1017": {
          "capabilities": { "input": ["text", "image"] },
          "limit": { "input": 307200 }
        },
        "zai-glm-5-3": {
          "limit": { "input": 307200 }
        },
        "zai-glm-5-3-longctx": {
          "modelID": "zai-glm-5-3",
          "name": "Z.ai GLM 5.3 (long ctx)",
          "limit": { "input": 607200 }
        },
        "zai-glm-5-3-flash": {
          "limit": { "input": 307200 }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": { "input": 278528 }
        },
        "gpt-6-luna": {
          "limit": { "input": 278528 }
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/stacks/.playwright-out/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/secrets/*", "effect": "ask" },
    { "action": "read", "resource": "/opt/secrets/*", "effect": "deny" },
    { "action": "edit", "resource": "/opt/secrets/*", "effect": "deny" },
    { "action": "shell", "resource": "*/opt/secrets*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "curl * | *", "effect": "ask" },
    { "action": "shell", "resource": "wget * | *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git -*push*", "effect": "ask" },
    { "action": "shell", "resource": "*wrangler deploy*", "effect": "ask" },
    { "action": "shell", "resource": "*wrangler publish*", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "unlink *", "effect": "ask" },
    { "action": "shell", "resource": "find * -delete*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop*", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker volume prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker container prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker compose down*", "effect": "ask" },
    { "action": "shell", "resource": "docker-compose down*", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "chgrp *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "ask" },
    { "action": "shell", "resource": "wipefs *", "effect": "ask" },
    { "action": "shell", "resource": "shred *", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "killall *", "effect": "ask" },
    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl stop *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl restart *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl reload *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl disable *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl mask *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl kill *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl poweroff *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl reboot *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl halt *", "effect": "ask" },
    { "action": "shell", "resource": "reboot*", "effect": "ask" },
    { "action": "shell", "resource": "shutdown *", "effect": "ask" },
    { "action": "shell", "resource": "poweroff*", "effect": "ask" },
    { "action": "shell", "resource": "*--break-system-packages*", "effect": "deny" }
  ],
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true
    },
    "deep-research": {
      "type": "local",
      "command": [
        "uvx", "--with", "fastmcp", "--with", "httpx", "python",
        "/opt/stacks/webui/mcpo/deep-research/deep_research_mcp_server.py"
      ],
      "timeout": 300000,
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer {file:/opt/secrets/github.token}" }
    },
    "trilium": {
      "type": "local",
      "command": ["npx", "-y", "triliumnext-mcp"],
      "timeout": 30000,
      "environment": {
        "TRILIUM_API_URL": "http://192.168.0.46:9910/etapi",
        "TRILIUM_API_TOKEN": "{file:/opt/secrets/trilium.token}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["docker", "run", "--rm", "-i", "--network", "host", "-v", "/opt/stacks:/opt/stacks:ro", "-v", "/opt/stacks/.playwright-out:/opt/stacks/.playwright-out", "mcr.microsoft.com/playwright/mcp:latest", "--headless", "--browser", "chromium", "--output-dir", "/opt/stacks/.playwright-out"],
      "timeout": 30000
    },
    "comfyui": {
      "type": "local",
      "command": ["uv", "run", "--with", "mcp>=2,<3", "python", "/opt/stacks/comfyui-mcp/server.py"],
      "timeout": 900000,
      "environment": {
        "COMFYUI_URL": "http://192.168.0.46:8189"
      }
    },
    "godot-ai": {
      "type": "local",
      "command": ["/home/johannes/.local/bin/uvx", "--python", "3.12", "--isolated", "--no-config", "--no-env-file", "--no-sources", "--no-build", "--index-strategy", "first-index", "--keyring-provider", "disabled", "--index", "https://pypi.org/simple", "--default-index", "https://pypi.org/simple", "--find-links", "https://pypi.org/simple/godot-ai/", "--link-mode", "copy", "--from", "godot-ai==4.3.0", "godot-ai", "attach", "--port", "8000", "--ws-port", "9500"],
      "timeout": 120000,
      "enabled": true
    }
  }
}
