{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@makcimbx/opencode-gpt-imagegen"],
  "websearch": {
    "provider": "exa"
  },
  "small_model": "opencode/big-pickle",
  "providers": {
    "opencode-go": {
      "models": {
        "claude-haiku-5-5": {
          "limit": { "input": 106496 }
        },
        "gpt-5.6-luna": {
          "limit": { "input": 255616 }
        },
        "gpt-6-luna": {
          "limit": { "input": 255616 }
        },
        "deepseek-v4.1-flash": {
          "limit": { "input": 262144 }
        },
        "glm-5.3-flash": {
          "limit": { "input": 262144 }
        },
        "qwen3.8-flash": {
          "limit": { "input": 262144 }
        }
      }
    },
    "llama-cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "settings": {
        "baseURL": "http://192.168.0.46:4000/v1",
        "apiKey": "{file:/opt/secrets/litellm.key}"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": { "context": 105472, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "qwen3.8-27b-abliterated": {
          "name": "qwen3.8-27b-abliterated",
          "limit": { "context": 105472, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "nemotron-bolt": {
          "name": "nemotron-bolt",
          "limit": { "context": 262144, "output": 16384 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        }
      }
    },
    "mistral": {
      "models": {
        "zai-glm-5-3": {
          "limit": { "input": 307200 }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": { "input": 278528 }
        },
        "gpt-6-luna": {
          "limit": { "input": 278528 }
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/stacks/.playwright-out/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/secrets/*", "effect": "ask" },
    { "action": "read", "resource": "/opt/secrets/*", "effect": "deny" },
    { "action": "edit", "resource": "/opt/secrets/*", "effect": "deny" },
    { "action": "shell", "resource": "*/opt/secrets*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "curl * | *", "effect": "ask" },
    { "action": "shell", "resource": "wget * | *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true
    },
    "deep-research": {
      "type": "local",
      "command": [
        "uvx", "--with", "fastmcp", "--with", "httpx", "python",
        "/opt/stacks/webui/mcpo/deep-research/deep_research_mcp_server.py"
      ],
      "timeout": 300000,
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer {file:/opt/secrets/github.token}" }
    },
    "trilium": {
      "type": "local",
      "command": ["npx", "-y", "triliumnext-mcp"],
      "timeout": 30000,
      "environment": {
        "TRILIUM_API_URL": "http://192.168.0.46:9910/etapi",
        "TRILIUM_API_TOKEN": "{file:/opt/secrets/trilium.token}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["docker", "run", "--rm", "-i", "--network", "host", "-v", "/opt/stacks:/opt/stacks:ro", "-v", "/opt/stacks/.playwright-out:/opt/stacks/.playwright-out", "mcr.microsoft.com/playwright/mcp:latest", "--headless", "--browser", "chromium", "--output-dir", "/opt/stacks/.playwright-out"],
      "timeout": 30000
    },
    "comfyui": {
      "type": "local",
      "command": ["uv", "run", "--with", "mcp>=2,<3", "python", "/opt/stacks/comfyui-mcp/server.py"],
      "timeout": 900000,
      "environment": {
        "COMFYUI_URL": "http://192.168.0.46:8189"
      }
    },
    "godot-ai": {
      "type": "local",
      "command": ["/home/johannes/.local/bin/uvx", "--python", "3.12", "--isolated", "--no-config", "--no-env-file", "--no-sources", "--no-build", "--index-strategy", "first-index", "--keyring-provider", "disabled", "--index", "https://pypi.org/simple", "--default-index", "https://pypi.org/simple", "--find-links", "https://pypi.org/simple/godot-ai/", "--link-mode", "copy", "--from", "godot-ai==4.3.0", "godot-ai", "attach", "--port", "8000", "--ws-port", "9500"],
      "timeout": 120000,
      "enabled": true
    }
  }
}
