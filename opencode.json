{
  "$schema": "https://opencode.ai/config.json",
  "model": "mistral/auto",
  "plugins": [
    "/opt/stacks/.opencode/session-cost-plugin",
    {
      "package": "/opt/stacks/.opencode/session-model-plugin",
      "options": {
        "agents": ["alloy", "build", "plan"],
        "models": ["mistral/*"],
        "routing": {
          "selector": "mistral/mistral-large-4#medium",
          "timeoutMs": 45000,
          "candidates": [
            { "model": "mistral/deepseek-v4-1-flash-1017#high", "description": "AA index 29; $0.46/task (AA reference). Economical coding, debugging and tool automation." },
            { "model": "mistral/deepseek-v4-1-flash-1017#max", "description": "AA index 33; $0.60/task (AA reference). Value-focused coding and tool automation with deeper reasoning." },
            { "model": "mistral/mistral-large-4#medium", "description": "AA index 23; $1.41/task (AA reference). General-purpose work, visual understanding and document workflows." },
            { "model": "mistral/mistral-large-4#high", "description": "AA index 26; $2.06/task (AA reference). Repository understanding, visual reasoning and scientific coding." },
            { "model": "mistral/zai-glm-5-3#high", "description": "$3.29/task. Preferred over DeepSeek for complex engineering and long-horizon work." },
            { "model": "mistral/zai-glm-5-3#max", "description": "AA index 32; $5.01/task (AA reference). Preferred strongest option for difficult engineering, terminal work and high stakes." },
            { "model": "mistral/zai-glm-5-3-longctx#max", "description": "Same GLM Max; $5.01/task AA baseline, not a long-context estimate. Use only when very large context is explicitly needed." }
          ]
        }
      }
    },
    {
      "package": "/opt/stacks/.opencode/session-dashboard-plugin",
      "options": {
        "tui": { "panel": true, "footer": true },
        "gui": { "panel": true, "composerPill": true }
      }
    }
  ],
  "websearch": {
    "provider": "exa"
  },
  "agents": {
    "title": {
      "model": "mistral/mistral-small-latest"
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "opencode-go", "effect": "deny" },
    { "action": "provider.use", "resource": "opencode", "effect": "deny" }
  ],
  "providers": {
    "llama-cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "settings": {
        "baseURL": "http://192.168.0.46:4000/v1",
        "apiKey": "{file:/opt/secrets/litellm.key}"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": { "context": 139264, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "qwen3.8-27b-abliterated": {
          "name": "qwen3.8-27b-abliterated",
          "limit": { "context": 139264, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "inkling-2-mini": {
          "name": "inkling-2-mini",
          "limit": { "context": 83968, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "settings": { "reasoningEffort": "high" },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
    "mistral": {
      "models": {
        "mistral-medium-latest": { "disabled": true },
        "mistral-medium-2604": { "disabled": true },
        "ministral-14b-2512": { "disabled": true },
        "ministral-3b-2512": { "disabled": true },
        "ministral-8b-2512": { "disabled": true },
        "ministral-3b-latest": { "disabled": true },
        "ministral-8b-latest": { "disabled": true },
        "codestral-2508": { "disabled": true },
        "codestral-latest": { "disabled": true },
        "voxtral-small-2507": { "disabled": true },
        "voxtral-small-latest": { "disabled": true },
        "mistral-large-2512": { "disabled": true },
        "mistral-large-latest": { "disabled": true },
        "auto": {
          "modelID": "deepseek-v4-1-flash-1017",
          "name": "Auto (routed)",
          "limit": { "input": 307200 }
        },
        "deepseek-v4-1-flash-1017": {
          "capabilities": { "input": ["text", "image"] },
          "limit": { "input": 307200 }
        },
        "zai-glm-5-3": {
          "limit": { "input": 307200 }
        },
        "zai-glm-5-3-longctx": {
          "modelID": "zai-glm-5-3",
          "name": "Z.ai GLM 5.3 (long ctx)",
          "limit": { "input": 607200 }
        },
        "zai-glm-5-3-flash": {
          "limit": { "input": 307200 }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": { "input": 307200 }
        },
        "gpt-6-luna": {
          "limit": { "input": 278528 }
        }
      }
    }
  },
  "permissions": [
    { "action": "cloudflare_*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*_get", "resource": "*", "effect": "allow" },
    { "action": "cloudflare_*_list", "resource": "*", "effect": "allow" },
    { "action": "cloudflare_*token*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Token*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*secret*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Secret*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*credential*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Credential*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*logs*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Logs*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*audit*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Audit*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*billing*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Billing*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*payment*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Payment*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*content*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Content*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*download*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Download*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*raw*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*environment*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*bindings*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_*Bindings*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_kv_*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_r2_objects*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_artifacts_*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_agentMemory_*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_o11y_*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_emailSecurity_investigate*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_emailSending_get", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_workers*_get", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_pages*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_zeroTrust_access_identityProviders*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_zeroTrust_dlp*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_zeroTrust_casb*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_aiSearch_items*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_workflows_instances*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_urlScanner_responses_get", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_magicTransit_pcaps*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare_zaraz_export_get", "resource": "*", "effect": "ask" },
    { "action": "opencode_list_mcp_resources", "resource": "cloudflare", "effect": "ask" },
    { "action": "opencode_read_mcp_resource", "resource": "cloudflare:*", "effect": "ask" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.envrc", "effect": "ask" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" },
    { "action": "read", "resource": "*credentials.json", "effect": "ask" },
    { "action": "read", "resource": "*credentials.yml", "effect": "ask" },
    { "action": "read", "resource": "*credentials.yaml", "effect": "ask" },
    { "action": "read", "resource": "*.credentials*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/stacks/.playwright-out/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/secrets/*", "effect": "ask" },
    { "action": "read", "resource": "/opt/secrets/*", "effect": "deny" },
    { "action": "edit", "resource": "/opt/secrets/*", "effect": "deny" },
    { "action": "shell", "resource": "*/opt/secrets*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "curl * | *", "effect": "ask" },
    { "action": "shell", "resource": "wget * | *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git -*push*", "effect": "ask" },
    { "action": "shell", "resource": "*wrangler deploy*", "effect": "ask" },
    { "action": "shell", "resource": "*wrangler publish*", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "unlink *", "effect": "ask" },
    { "action": "shell", "resource": "find * -delete*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop*", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker volume prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker container prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker compose down*", "effect": "ask" },
    { "action": "shell", "resource": "docker-compose down*", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "chgrp *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "ask" },
    { "action": "shell", "resource": "wipefs *", "effect": "ask" },
    { "action": "shell", "resource": "shred *", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "killall *", "effect": "ask" },
    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl stop *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl restart *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl reload *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl disable *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl mask *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl kill *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl poweroff *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl reboot *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl halt *", "effect": "ask" },
    { "action": "shell", "resource": "reboot*", "effect": "ask" },
    { "action": "shell", "resource": "shutdown *", "effect": "ask" },
    { "action": "shell", "resource": "poweroff*", "effect": "ask" },
    { "action": "shell", "resource": "*--break-system-packages*", "effect": "deny" }
  ],
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true
    },
    "deep-research": {
      "type": "local",
      "command": [
        "uvx", "--with", "fastmcp", "--with", "httpx", "python",
        "/opt/stacks/webui/mcpo/deep-research/deep_research_mcp_server.py"
      ],
      "timeout": 300000,
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer {file:/opt/secrets/github.token}" }
    },
    "trilium": {
      "type": "local",
      "command": ["npx", "-y", "triliumnext-mcp"],
      "timeout": 30000,
      "environment": {
        "TRILIUM_API_URL": "http://192.168.0.46:9910/etapi",
        "TRILIUM_API_TOKEN": "{file:/opt/secrets/trilium.token}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["docker", "run", "--rm", "-i", "--network", "host", "-v", "/opt/stacks:/opt/stacks:ro", "-v", "/opt/stacks/.playwright-out:/opt/stacks/.playwright-out", "mcr.microsoft.com/playwright/mcp:latest", "--headless", "--browser", "chromium", "--output-dir", "/opt/stacks/.playwright-out"],
      "timeout": 30000
    },
    "comfyui": {
      "type": "remote",
      "url": "{file:/opt/secrets/comfyui-mcp.url}",
      "oauth": false,
      "timeout": 900000
    },
    "godot-ai": {
      "type": "local",
      "command": ["/home/johannes/.local/bin/uvx", "--python", "3.12", "--isolated", "--no-config", "--no-env-file", "--no-sources", "--no-build", "--index-strategy", "first-index", "--keyring-provider", "disabled", "--index", "https://pypi.org/simple", "--default-index", "https://pypi.org/simple", "--find-links", "https://pypi.org/simple/godot-ai/", "--link-mode", "copy", "--from", "godot-ai==4.3.0", "godot-ai", "attach", "--port", "8000", "--ws-port", "9500"],
      "timeout": 120000,
      "enabled": true
    },
    "servers": {
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      }
    }
  }
}
