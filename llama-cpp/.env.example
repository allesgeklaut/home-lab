# llama.cpp stack configuration
# =============================
# Template only: copy to .env and adjust. .env is gitignored (no secrets
# are committed; this file contains none).
# Bind address for the server port.
#   - 127.0.0.1  -> localhost only (not reachable from other machines)
#   - 192.168.1.10 -> your LAN IP, reachable from other devices on your network
#   - 0.0.0.0    -> all interfaces (broadest, avoid unless needed)
LLAMA_HOST_IP=192.168.1.10

# Model file to serve (must exist in ./models/)
# UkisAI Swift 1.5 Qwen3.8-27B GSQ-RCO IQ3_S (3.50 bpw) with embedded MTP head.
LLAMA_MODEL=Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf

# Model alias exposed via the API
LLAMA_ALIAS=qwen3.8:27b

# Multimodal projector for vision (must exist in ./models/)
# GSQ-RCO repo's own mmproj, verified against the GSQ-RCO quants.
LLAMA_MMPROJ=mmproj-Qwen3.8-27B-BF16.gguf

# Context window size in tokens (must be >= opencode.json's limit.context,
# currently 131072, since opencode reaches the model through litellm).
LLAMA_CTX_SIZE=135168

# Concurrent request slots (each uses KV cache memory)
LLAMA_PARALLEL=1

# Prompt processing batch sizes:
#   LLAMA_BATCH_SIZE  = logical batch (max prompt tokens per chunk)
#   LLAMA_UBATCH_SIZE = physical batch (tokens per GPU graph; larger = faster
#                       prefill, bigger compute buffer -> needs more VRAM)
LLAMA_BATCH_SIZE=2048
LLAMA_UBATCH_SIZE=512

# KV cache quantization (q4_0, q8_0, f16, ...)
#   q4_0 = fastest, more layers fit in VRAM
#   q8_0 = higher precision, slightly slower
LLAMA_CACHE_TYPE_K=q4_0
LLAMA_CACHE_TYPE_V=q4_0

# Host-RAM prompt cache (llama-server --cache-ram, MiB).
# Default is only 8192 MiB — too small for long (90k+ token) conversations,
# which triggers LRU eviction and full re-prefills. Keep this bounded by
# the host's available RAM (compose falls back to 8192 if unset).
LLAMA_CACHE_RAM=16384

# Layer offload strategy:
#   LLAMA_FIT=on  -> auto-fit layers to VRAM (LLAMA_FIT_TARGET = margin in MiB)
#   LLAMA_FIT=off -> manual: LLAMA_N_GPU_LAYERS controls layer count
#   Note: with LLAMA_FIT=on, llama.cpp logs a harmless "n_gpu_layers already set" warning
LLAMA_FIT=off
LLAMA_FIT_TARGET=0
LLAMA_N_GPU_LAYERS=99

# Flash attention (on/off)
LLAMA_FLASH_ATTN=on

# Sampling parameters (thinking mode defaults)
LLAMA_TEMP=1.0
LLAMA_TOP_P=0.95
LLAMA_TOP_K=20
LLAMA_MIN_P=0.00
LLAMA_PRESENCE_PENALTY=0.0

# MTP speculative decoding draft length (2 is the sweet spot for 27B)
LLAMA_SPEC_DRAFT_N_MAX=2

# Minimum image tokens for vision grounding (1024 recommended for Qwen-VL)
LLAMA_IMAGE_MIN_TOKENS=1024

# ---------------------------------------------------------------------------
# Abliterated companion model (served by llama-companion on port 8086).
# Repurposed from the retired Qwen3.5-9B companion. Served with the SAME
# runtime settings as the main model: every LLAMA_* value above applies to
# both containers, only the model, projector and alias differ.
# ---------------------------------------------------------------------------
COMPANION_MODEL=Huihui-Qwen3.8-27B-abliterated-GSQ-RCO-IQ3_S-mtp.gguf

# Model alias exposed via the API
COMPANION_ALIAS=qwen3.8:27b-abliterated

# Multimodal projector for vision (must exist in ./models/). Same projector as
# the main model: Huihui is a Qwen3.8-27B derivative, so the vision tower
# matches.
COMPANION_MMPROJ=mmproj-Qwen3.8-27B-BF16.gguf
