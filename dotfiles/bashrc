# opencode
export PATH=/home/johannes/.opencode/bin:$PATH
# TUI on the same server as the web UI (systemd opencode-web, 127.0.0.1:4096).
# That server requires its password; pass it via OPENCODE_PASSWORD for this
# command only, read from the same secret env file the systemd service uses.
# --server goes after "$@" because the CLI rejects it before a subcommand.
oc() {
  local pw
  pw=$(sed -n 's/^OPENCODE_SERVER_PASSWORD=//p' /opt/secrets/opencode-web.env)
  if [ -z "$pw" ]; then
    echo "oc: OPENCODE_SERVER_PASSWORD not found in /opt/secrets/opencode-web.env" >&2
    return 1
  fi
  OPENCODE_PASSWORD="$pw" opencode "$@" --server http://127.0.0.1:4096
}
export EDITOR="nvim"

# Auto-attach tmux only for real SSH sessions: sshd sets SSH_CONNECTION,
# local terminals (VS Code, console) don't. TERM_PROGRAM=vscode also skips
# VS Code's Remote-SSH integrated terminals, which do run over ssh.
if [ -n "$SSH_CONNECTION" ] && [ "$TERM_PROGRAM" != "vscode" ] && command -v tmux &> /dev/null && [ -z "$TMUX" ]; then tmux attach 2>/dev/null || tmux new; fi

# Enable opencode websearch (Exa) for custom providers
export OPENCODE_ENABLE_EXA=1
export OPENCODE_WEBSEARCH_PROVIDER=exa
export EXA_API_KEY="$(cat /opt/secrets/exa.key)"
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=1

# Engram cloud autosync — server URL from ~/.engram/cloud.json, token from the
# secret file (env takes precedence, so `engram cloud config` can't wipe it)
export ENGRAM_CLOUD_AUTOSYNC=1
export ENGRAM_CLOUD_TOKEN="$(cat /opt/secrets/engram-cloud.token)"
