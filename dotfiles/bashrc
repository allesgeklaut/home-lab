# --- System Configuration ---

# User specific environment (PATH)
path_add() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) export PATH="$1:$PATH" ;;
    esac
}
path_add "$HOME/.local/bin"
path_add "$HOME/bin"
path_add "$HOME/.cargo/bin"
path_add "/home/linuxbrew/.linuxbrew/bin/"
path_add "/opt/nvim-linux-x86_64/bin"

# --- Shell Options & History ---
HISTCONTROL=ignoredups:ignorespace
shopt -s histappend
HISTSIZE=1000000
HISTFILESIZE=1000000
shopt -s checkwinsize
set -o vi

[ -f ~/.fzf.bash ] && source ~/.fzf.bash

# --- Prompt Logic (Hacker Style) ---
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

function _build_prompt() {
    local EXIT=$?
    local RED='\[\033[0;31m\]'
    local GREEN='\[\033[0;32m\]'
    local BLUE='\[\033[0;34m\]'
    local CYAN='\[\033[0;36m\]'
    local WHITE='\[\033[0;37m\]'
    local RESET='\[\033[0m\]'

    # Prompt: user@host:dir (branch) ❯
    # Green symbol on success, Red on error.
    local PROMPT_SYMBOL="$GREEN❯$RESET"
    if [ $EXIT -ne 0 ]; then
        PROMPT_SYMBOL="$RED❯$RESET"
    fi

    PS1="${WHITE}\u@\h${RESET}:${BLUE}\w${RESET} ${CYAN}\$(parse_git_branch) \e[0m$PROMPT_SYMBOL "
}

# Re-evaluate prompt on every command to update color and git info
PROMPT_COMMAND="_build_prompt"

