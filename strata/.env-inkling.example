# Settings for the second Strata tenant: Inkling-2-Mini (service strata-inkling).
#
# This file is deliberately separate from .env: the Qwen tenant pins the IQ3_S
# pack, a 196k window, MODEL_PATH and a conversation-cache STRATA_SET, none of
# which belong to the inkling shape engine. Copy this file to `.env-inkling`
# (gitignored) and edit that.
#
# The API key is NOT here — it comes from /opt/secrets/strata.env (API_KEY),
# the same file the Qwen tenant and litellm use.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Inkling-2-Mini runs on its own shape engine (`strata-inkling`), which Strata
# downloads on the first start. Use a NATIVE `.strata` build, not a GGUF:
#   SQ-20       20.0 GB  native SF4+MX8, bit-exact lossless — the 24 GiB-card build
#   SQ-15       15.0 GB  native, vendor: beats UD-Q4_K_XL — the 16 GiB-card build (pick)
#   SQ-10       10.5 GB  compact high-speed build (12 GB cards)
# Measured here at 128K/fp8: SQ-15 24.2 tok/s decode, 249 tok/s prefill (2.4K
# prompt); SQ-20 13.1 tok/s at the same context, because it fits 1.5 GiB fewer
# experts in VRAM. The Unsloth UD-Q8_K_XL GGUF booted at 9 tok/s at 256K, the
# same as SQ-20 there, so the format was not the limiter. At 256K on HIP the
# planner reserves the whole global K/V in VRAM (8.6 GB FP16 x1.6 growth = 13.7 GB)
# beside the dense trunk and plans --vram-experts-gb 0.00: every routed expert streams
# from RAM/SSD. The Qwen tenant gets 48-49 tok/s because its engine runs a
# different expert-cache mechanism, not because of the pack format.
# `strata launch --plan --family inkling-2-mini --model <build> --context 256k`
# prints the fit for any of them and changes nothing.
FAMILY=inkling-2-mini
MODEL=SQ-15

# Preset name in /data. Both tenants share one volume, so this must differ from
# the Qwen tenant's preset ('docker'); it keeps presets, launch files and engine
# logs apart.
PRESET=inkling

# Context window. 128K, not the 256K the model was trained on: on HIP the global
# K/V stays in VRAM (host K/V offload is CUDA-only), so at 256K it pins ~13.7 GB
# with growth and leaves 0 GB for experts. 128K + fp8 plans 7.84 GiB of experts
# in VRAM for SQ-15 (6.8 GB for SQ-20; 8.5 GB at 64K) — the speed/context trade.
# 400K works too but the engine warns: "400K is more than the model was trained
# on (256K). Setup adds rope scaling for it (experimental); answers may get less
# reliable." Anything above 256K is that trade.
CONTEXT=131072
# 8-bit K/V (fp8): halves the global K/V. No q8_0 here: Inkling's engine takes
# fp16/fp8 only on HIP; k8v4/k8v8 are CUDA formats and fall back to fp8.
KV=fp8

# Requests answered at the same time.
PARALLEL=1

# Pictures: off | on | cpu | gpu. The SQ build ships picture reading, and on a
# card this full the reader runs on the CPU (a few seconds per picture).
VISION=on

# Drafter: auto | off | dspark. DSpark is built into the SQ builds, but the
# launcher measured 0.92x at 128K (0.80x at 256K): off is faster here, and it
# skips the multi-minute re-probe on every settings change.
DRAFTING=off

# No one-off tuning: leave the shipped defaults.
TUNE=skip

# What is deliberately NOT set here:
#   KV       — the inkling shape engine picks its own K/V format.
#   MODEL_PATH — that is the Qwen size-folder mount (/models/IQ3_S); this tenant
#              downloads its pack into the shared volume instead.
#   STRATA_SET — engine settings written for the Qwen engine do not apply.
