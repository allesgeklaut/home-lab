# Settings for the second Strata tenant: Inkling-2-Mini (service strata-inkling).
#
# This file is deliberately separate from .env: the Qwen tenant pins the IQ3_S
# pack, a 196k window, MODEL_PATH and a conversation-cache STRATA_SET, none of
# which belong to the inkling shape engine. Copy this file to `.env-inkling`
# (gitignored) and edit that.
#
# The API key is NOT here — it comes from /opt/secrets/strata.env (API_KEY),
# the same file the Qwen tenant and litellm use.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Inkling-2-Mini runs on its own shape engine (`strata-inkling`), which Strata
# downloads on the first start. This box has 16 GB of VRAM but 62 GB of RAM, and
# this engine plans from the whole computer — so the pick is the largest build,
# not the one that fits the card:
#   UD-Q8_K_XL  23.9 GB  Unsloth 8-bit GGUF — the pick: ~16 GB resident in VRAM,
#                       the rest streamed per token. No fit warning from the
#                       planner at 256K, and DSpark drafting is built in.
# Alternatives, all planned for this box:
#   SQ-20       20.0 GB  native SF4+MX8, near-lossless, smaller download
#   SQ-15       15.0 GB  native, fits the card outright
#   SQ-10       10.5 GB  compact high-speed build (12 GB cards)
# `strata launch --plan --family inkling-2-mini --model <build> --context 256k`
# prints the fit for any of them and changes nothing.
FAMILY=inkling-2-mini
MODEL=UD-Q8_K_XL

# Preset name in /data. Both tenants share one volume, so this must differ from
# the Qwen tenant's preset ('docker'); it keeps presets, launch files and engine
# logs apart.
PRESET=inkling

# Context window. 256K is what the model was trained on, so it needs no rope
# scaling. The launcher's default for this build is only 32K — that is a
# conservative pick, not a limit; 256K costs pinned RAM, not VRAM.
# 400K works too but the engine warns: "400K is more than the model was trained
# on (256K). Setup adds rope scaling for it (experimental); answers may get less
# reliable." Anything above 256K is that trade.
CONTEXT=262144

# Requests answered at the same time.
PARALLEL=1

# Pictures: off | on | cpu | gpu. The SQ build ships picture reading, and on a
# card this full the reader runs on the CPU (a few seconds per picture).
VISION=on

# Drafter: auto | off | dspark. DSpark is built into the SQ builds; `auto` keeps
# the launcher's first-start measurement (it stays on where it is at least 10%
# faster on code and chat).
DRAFTING=auto

# No one-off tuning: leave the shipped defaults.
TUNE=skip

# What is deliberately NOT set here:
#   KV       — the inkling shape engine picks its own K/V format.
#   MODEL_PATH — that is the Qwen size-folder mount (/models/IQ3_S); this tenant
#              downloads its pack into the shared volume instead.
#   STRATA_SET — engine settings written for the Qwen engine do not apply.
