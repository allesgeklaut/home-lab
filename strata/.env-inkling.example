# Settings for the second Strata tenant: Inkling-2-Mini (service strata-inkling).
#
# This file is deliberately separate from .env: the Qwen tenant pins the IQ3_S
# pack, a 196k window, MODEL_PATH and a conversation-cache STRATA_SET, none of
# which belong to the inkling shape engine. Copy this file to `.env-inkling`
# (gitignored) and edit that.
#
# The API key is NOT here — it comes from /opt/secrets/strata.env (API_KEY),
# the same file the Qwen tenant and litellm use. The published port is
# STRATA_INKLING_PORT in .env (compose), not in this service env_file.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Inkling-2-Mini runs on its own shape engine (`strata-inkling`), which Strata
# downloads on the first start. Use a NATIVE `.strata` build, not a GGUF:
#   SQ-20       19.35 GB  native SF4+MX8, bit-exact lossless — the 24 GiB-card build
#   SQ-15       14.35 GB  native, vendor: beats UD-Q4_K_XL — the 16 GiB-card build (pick)
#   SQ-10       10.47 GB  compact high-speed build (12 GB cards)
# The 0.64 GB / 0.59 GiB Vision shard is separate from these LM files.
# Measured here at 256K/fp8 with all experts on the card (11.46 GiB VRAM cap,
# 0.82 GiB RAM fallback unused): SQ-15 40.7 tok/s decode, 1284 tok/s prefill
# (2.4K prompt).
# SQ-20 cannot hold its experts on a 16 GiB card (13.1 tok/s at 128K); it is
# the 24 GiB build. The Unsloth UD-Q8_K_XL GGUF booted at 9 tok/s at 256K, the
# same as SQ-20 there, so the format was not the limiter. The Qwen tenant gets
# 48-49 tok/s because its engine runs a different expert-cache mechanism, not
# because of the pack format.
#
# Placement: setup under-plans (7.84 GiB) and leaves ~3.6 GiB of experts in
# RAM. SQ-15's expert bodies are 11.44 GiB; the flags are GiB (the planner
# counts GB). Pin --vram-experts-gb 11.46 so the engine can hold all of them
# on the card; --ram-experts-gb 0.82 is a fallback, so experts that no longer
# fit land in RAM instead of the SSD. The README has the exact edit.
# `strata launch --plan --family inkling-2-mini --model <build> --context 256k`
# prints the fit for any of them and changes nothing.
FAMILY=inkling-2-mini
MODEL=SQ-15

# Preset name in /data. Both tenants share one volume, so this must differ from
# the Qwen tenant's preset ('docker'); it keeps presets, launch files and engine
# logs apart.
PRESET=inkling

# Context window. 256K is the trained window, and all experts still fit on the
# card. K/V stays on the card until the ~1.5 GB of headroom is used (roughly the
# first 30-50K tokens); beyond that the engine spills K/V to RAM, which works
# but slows long prompts: measured 620 tok/s prefill and 16.7 tok/s decode at
# 120K, against 1284 / 40.7 at 2.4K. Retrieval at 50K and 120K was correct.
# 400K is accepted with rope scaling but is beyond the trained window: "Setup
# adds rope scaling for it (experimental); answers may get less reliable."
# Anything above 256K is that trade.
#
# Tested limit: 120K served correctly. A later run on this same 256K config
# died with `[ink-hip] alloc_gpu_buffer: out of memory` and the engine
# restarted; treat 256K as the trained ceiling, not guaranteed headroom.
CONTEXT=262144
# 8-bit K/V (fp8): halves the global K/V. No q8_0 here: Inkling's engine takes
# fp16/fp8 only on HIP; k8v4/k8v8 are CUDA formats and fall back to fp8.
KV=fp8

# Requests answered at the same time.
PARALLEL=1

# Pictures: off | on | cpu | gpu. The SQ build ships picture reading, and on a
# card this full the reader runs on the CPU (a few seconds per picture).
VISION=on

# Drafter: auto | mtp | dflash2 | off. Inkling's MTP is the DSpark drafter (the
# engine gets --draft dspark); "dspark" itself is not a valid value here.
# Measured 2026-11-26 with DSpark forced on: slower on every workload — prose
# 42.5 -> 34.4, code 43.2 -> 42.0, JSON 43.6 -> 33.9, 2.6K prompt 40.5 -> 33.9
# — with only 22-37% of drafts accepted, and it takes ~1 GiB of KV room
# (prefill 1220 -> 921, chunk cap 512 -> 256). Off.
DRAFTING=off

# No one-off tuning: leave the shipped defaults.
TUNE=skip

# What is deliberately NOT set here:
#   MODEL_PATH — that is the Qwen size-folder mount (/models/IQ3_S); this tenant
#              downloads its pack into the shared volume instead.
#   STRATA_SET — engine settings written for the Qwen engine do not apply.
