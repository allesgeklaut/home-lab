# Strata stack configuration — copy to .env, then edit.
#
#   cp .env.example .env
#   (the API key lives in /opt/secrets/strata.env, not here)
#
# This file configures the Qwen3.8-Flash-Next tenant (`strata`, port 8090). The
# second tenant, Inkling-2-Mini (`strata-inkling`, port 8091), has its own file:
# copy `.env-inkling.example` to `.env-inkling`. Both are read by the same
# compose file; STRATA_HOST_IP and the ports below are shared.
#
# Every value maps to an environment variable of the container; the list and
# defaults are in the upstream docs/DOCKER.md.

# Bind address for the published port.
#   - 127.0.0.1    -> localhost only (litellm could not reach it)
#   - 192.168.0.46 -> LAN IP; needed so litellm (a container) can reach it
#   - 0.0.0.0      -> all interfaces (broadest, avoid unless needed)
STRATA_HOST_IP=192.168.0.46

# Host port. 8090 keeps clear of llama.cpp (8084-8086) and comfyui (8188/8189).
STRATA_PORT=8090

# Release tag of the image flavor for this card. The RX 9060 XT is RDNA 4
# (gfx1200), so it takes the rocm-gfx120x flavor. Bump the version part to move
# releases: ghcr.io/niko1221/strata:<version>-rocm-gfx120x
STRATA_IMAGE_TAG=0.2.21-rocm-gfx120x

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Family: qwen (ISTA-DASLab original packs, Strata's first recommendation),
# qwen36, hy4-flash, inkling-2-mini, unsloth, gyro, coder, swift, nvfp4.
FAMILY=qwen

# Size. IQ3_S needs 54.8 GB for the weights, i.e. it fits a 64 GB host only
# with little else open (see the stack README for the trade-off).
#   Q2_0    37.6 GB  fastest, good
#   IQ2_XS  39.2 GB  fast, better
#   IQ3_XXS 47.0 GB  slower, great
#   IQ3_S   54.8 GB  slowest, best
# Hy4-Flash packs instead use SQ-64 / SQ-96 / SQ-128 with FAMILY=hy4-flash.
MODEL=IQ3_S

# Context the model gets in tokens. 196608 is what this host runs: measured
# 2026-11-25, 64k -> 128k -> 192k cost no VRAM (835-884 MiB free, because only
# --kv-resident stays in VRAM) and no decode speed (48.0-49.0 tok/s). Raising
# it does cost pinned RAM: the whole K/V lives there, 0.84 GiB at 128k and
# 1.27 GiB at 192k. 256k is the launcher's next step and the model's trained
# ceiling. A 135107-token prompt served in 137 s (985 tok/s prefill).
CONTEXT=196608

# Requests answered at the same time (1-8). One keeps the whole VRAM for the
# experts; raise only after measuring.
PARALLEL=1

# KV cache format: int8 (default), k8v4, q4_0, fp16.
# k8v4 is what this host runs (INT8 K, exact attention scores, + rotated Q4_0
# V = 816 B/cell). Measured 2026-11-25 at 192k against q4_0 (528 B/cell): same
# speed (49.2 vs 48.0 tok/s decode, 925 vs 931 tok/s on a 12.1k prompt) and
# same VRAM, for 0.52 GiB more pinned RAM (1.79 vs 1.27 GiB for the whole K/V).
# q4_0 is the leaner choice if RAM ever gets tight; fp16 doubles k8v4 again.
KV=k8v4

# Pictures: off | on | cpu | gpu. This card is under 24 GB, so the reader runs
# on the CPU (measured ~2 s per 720x400 picture) and costs ~0.9 GB of RAM on
# top of the model. "on" is what this host runs: the reader loads in 0.7 s at
# start and only used RAM, no VRAM. "gpu" does not fit here — with the model
# loaded there are under 900 MiB of VRAM spare.
VISION=on

# Drafter for speculative decoding: auto | mtp | dflash2 | off.
DRAFTING=auto

# One-off tuning: quick | thorough | skip (kept in the preset afterwards;
# RETUNE=1 repeats it). "skip" uses the shipped defaults.
TUNE=skip

# Pre-downloaded model files instead of a download: uncomment together with
# the bind mount in compose.yml. The upstream repos keep one folder per size,
# so name that folder (it must hold the model's files directly, not another
# level of folders):
#   hf download ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF --include "IQ3_S/*" --local-dir /opt/stacks/strata/models
# MODEL_PATH=/models/IQ3_S

# Advanced engine settings, space separated, as `strata launch --set` takes
# them, e.g. STRATA_SET="prefill=65536 STRATA_PIN_BY_NEED=1".
#
# Do not pin expert_cache. Tried 2026-11-25: `expert_cache=5400` was clamped to
# 5284 slots / 10.05 GiB, left 203 MiB of VRAM free, and the engine warned
# "decode can be several times slower with the card this full". auto holds
# ~835 MiB back on purpose (700 MiB reserve, +380 draft head, +256 after the
# cache) — that is the working margin, not waste. Note that --set is saved into
# the launch preset, so removing it from here later does not clear it; edit
# /data/config/strata/launch-presets/docker.json (its "extra" object) instead.
#
# The conversation cache is what this host actually sets, and it needs both
# lines: the budget alone still obeys the RAM floor, and the floor alone never
# clears the auto-sizing (the log keeps saying "conversation cache off: not
# enough free RAM to park conversations").
#
# The budget decides the largest conversation you can park, not how many. A
# snapshot costs ~20-22 MiB per 1k tokens, measured 2026-11-25: 12k -> 356 MiB,
# 30k -> 664 MiB, 48k -> 971 MiB. So the first try at 512 MiB could never hold a
# 30k conversation, while 4096 can. Admission needs snapshot + floor under
# MemAvailable and evicts parked snapshots when that covers the shortfall:
# "evicted 3 parked conversations to admit this snapshot (664 MiB plus 1024 MiB
# floor)", then "parked 30170 tokens in 968.9 ms" and a repeat prompt in 1.29 s
# against 32.0 s cold (restored in 56.3 ms).
#
# Where the floor puts the ceiling. Admission is snapshot + floor under
# MemAvailable (~1.4-1.6 GiB idle here), so the floor decides what can ever be
# parked: 1024 allowed ~30k tokens, 512 reaches ~48k, 128 would take nearly all
# the RAM and was backed out as too aggressive. Measured at 512 on 2026-11-25: a
# 48k conversation parked ("parked 48170 tokens in 290.1 ms; parked=1
# bytes=1018591768", 971 MiB) where 1024 had refused it, and the repeat ran in
# 1.45 s against 84.6 s cold. Caveat: that snapshot did not survive the next
# request ("parked=0" right after), so the fast repeat came from the VRAM
# checkpoint ring ("restored 48102 tokens (checkpoint) in 77.3 ms") - on a tight
# host parked snapshots are the first thing given back.
#
# The engine's SSD overflow tier ("SSD tier in /data/Strata-data/conversation-
# spill/<id>, up to 32768 MiB") has no flag to size or disable it and writes only
# when an eviction sticks; the test runs left 0 bytes on the NVMe. Tiny side
# requests are skipped by the engine's own --conversation-cache-min-tokens 1024.
#
# A real 157-160k session needs ~2.5 GiB per snapshot ("need 2485 MiB plus 1024
# MiB floor, 986 MiB available ... short by 2523 MiB"), so no budget size saves
# it: the snapshot already fits a 4096 budget and admission is what refuses it.
# At that size the prefix checkpoints carry the session - the same log shows
# turns reusing in 0.31-1.33 s between the occasional 163 s cold prefill.
# Do not reach for conversation_cache_swap_block_mib expecting a way around
# this: it is only documented as "host K/V exchange block, 0..256 MiB (default
# 0: off)" and a 48k probe with 256 parked nothing, so it was reverted. Whatever
# --set values are used, they live in the preset's extra object and must be
# cleared there too (the JSON is hand-edited, so keep it valid - a dangling comma
# after the last entry breaks the preset).
STRATA_SET="conversation_cache_mib=2048 conversation_cache_min_free_mib=512"
